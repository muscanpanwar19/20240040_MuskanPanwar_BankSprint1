        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml BankSystemArchitecture\nskinparam classAttributeIconSize 0\nskinparam class {\n    BackgroundColor #F8FAFC\n    ArrowColor #0F172A\n    BorderColor #0F172A\n}\n\n&#39; ========================================================\n&#39; Customer Class\n&#39; ========================================================\nclass Customer {\n    - customerNumber : string\n    - name : string\n    - contactDetails : string\n    - isStaff : bool\n    - accounts : List&lt;Account&gt;\n    + Customer(customerNumber: string, name: string, contactDetails: string, isStaff: bool)\n    + AddAccount(account: Account) : void\n    + PrePopulateAccounts() : void\n    + GetCustomerDetails() : string\n}\n\n&#39; ========================================================\n&#39; Abstract Base Account Class\n&#39; ========================================================\nabstract class Account {\n    # accountNumber : string\n    # balance : decimal\n    # lastTransactionStatus : string\n    # owner : Customer\n    + Account(accountNumber: string, balance: decimal, owner: Customer)\n    + Deposit(amount: decimal) : bool\n    + {abstract} Withdraw(amount: decimal) : bool\n    + {abstract} CalculateInterest() : decimal\n    # GetFee(fee: decimal) : decimal\n    + GetAccountInfo() : string\n}\n\n&#39; ========================================================\n&#39; Everyday Account\n&#39; ========================================================\nclass EverydayAccount {\n    + EverydayAccount(accountNumber: string, balance: decimal, owner: Customer)\n    + Withdraw(amount: decimal) : bool &lt;&lt;override&gt;&gt;\n    + CalculateInterest() : decimal &lt;&lt;override&gt;&gt;\n}\n\n&#39; ========================================================\n&#39; Investment Account\n&#39; ========================================================\nclass InvestmentAccount {\n    - interestRate : decimal\n    - failedFee : decimal = 10.00\n    + InvestmentAccount(accountNumber: string, balance: decimal, interestRate: decimal, owner: Customer)\n    + Withdraw(amount: decimal) : bool &lt;&lt;override&gt;&gt;\n    + CalculateInterest() : decimal &lt;&lt;override&gt;&gt;\n}\n\n&#39; ========================================================\n&#39; Omni Account\n&#39; ========================================================\nclass OmniAccount {\n    - interestRate : decimal\n    - overdraftLimit : decimal\n    - failedFee : decimal = 10.00\n    + OmniAccount(accountNumber: string, balance: decimal, interestRate: decimal, overdraftLimit: decimal, owner: Customer)\n    + Withdraw(amount: decimal) : bool &lt;&lt;override&gt;&gt;\n    + CalculateInterest() : decimal &lt;&lt;override&gt;&gt;\n}\n\n&#39; ========================================================\n&#39; Relationships\n&#39; ========================================================\nAccount &lt;|-- EverydayAccount : extends\nAccount &lt;|-- InvestmentAccount : extends\nAccount &lt;|-- OmniAccount : extends\n\nCustomer \&quot;1\&quot; *-- \&quot;1..*\&quot; Account : owns (Composition) &gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rqsP2ji56TaNBZPB5kWC-91">
